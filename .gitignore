# ===================== JC RAG 开源版 .gitignore =====================
# 本文件随社区版独立仓库生效（从原 monorepo 根 .gitignore 裁剪而来）

# ---------- Java / Maven / Gradle ----------
**/target/
*.iml
*.class
*.jar
*.war
*.ear
.settings/
.project
.classpath

# ---------- Python (uv / venv) ----------
**/__pycache__/
**/.venv/
.venv/
venv/
*.pyc
*.pyo
*.egg-info/
**/.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-wheel-metadata/

# ---------- Node / Vue / Vite / pnpm ----------
**/node_modules/
**/dist/
**/dist-pro/
**/coverage/
.pnpm-store/
*.tsbuildinfo

# ---------- 前端构建产物注入 Spring Boot static（由前端构建生成，不入 git） ----------
jc-rag-backend/*/src/main/resources/static/assets/

# ---------- 商业版标识（社区版不含 .env.pro） ----------
jc-rag-frontend/jc-rag-admin-web/.env.pro

# ---------- 本地私有配置覆盖 (真实路径/凭证, 不入库) ----------
jc-rag-service/rag_config.local.yml
*.local.yml
*.local.yaml

# ---------- 环境变量 / 密钥（保留 .env.example 模板） ----------
.env
.env.*
!.env.example

# ---------- 日志 / 运行时 ----------
*.log
logs/
build-result.txt
pnpm-install.log

# ---------- 数据卷 / 本地数据（MySQL 等，体积大且不入库） ----------
volumes/

# ---------- 本地调试 / 临时文件 ----------
*.tmp
*.temp
*.bak
*.swp
*.swo
tmp/
.scratch/
.cache/

# ---------- 编译 / 构建残留（TS 编译产物 .js_del、uv 同步日志等，不入 git） ----------
*.js_del
uv-sync*.log*

# ---------- 操作系统 / IDE ----------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
