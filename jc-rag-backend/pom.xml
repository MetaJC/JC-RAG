<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <groupId>com.jc</groupId>
    <artifactId>jc-rag-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JC RAG</name>
    <modules>
        <module>jc-rag-common</module>
        <module>jc-rag-domain</module>
        <module>jc-rag-sms</module>
        <module>jc-rag-admin</module>
        <module>jc-rag-user</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <spring-boot.version>3.3.5</spring-boot.version>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <lombok.version>1.18.34</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jc</groupId>
                <artifactId>jc-rag-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jc</groupId>
                <artifactId>jc-rag-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                短信能力独立模块 (渠道抽象 + 验证码生命周期),
                自动装配注册, 供 user/admin 启动模块按需引入.
            -->
            <dependency>
                <groupId>com.jc</groupId>
                <artifactId>jc-rag-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                ★ 内部兄弟模块 jc-rag-admin 统一版本管理 ★
                场景: jc-rag-user 的 PublicEvaluationController 注入 ProEvaluationService (common.feature),
                而社区版唯一实现在 jc-rag-admin 的 ProEvaluationServiceOssImpl.
                user 启动类不扫 com.jc.rag.admin, 通过 @Bean 显式 new OssImpl 注册, 故 user 需引入 jc-rag-admin jar.
            -->
            <dependency>
                <groupId>com.jc</groupId>
                <artifactId>jc-rag-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <fork>true</fork>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <nonFilteredFileExtensions>
                            <nonFilteredFileExtension>properties</nonFilteredFileExtension>
                        </nonFilteredFileExtensions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
