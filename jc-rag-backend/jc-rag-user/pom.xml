<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jc</groupId>
        <artifactId>jc-rag-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>jc-rag-user</artifactId>
    <packaging>jar</packaging>
    <name>JC RAG User</name>
    <dependencies>
        <dependency>
            <groupId>com.jc</groupId>
            <artifactId>jc-rag-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jc</groupId>
            <artifactId>jc-rag-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            ★ 引入 jc-rag-admin 仅为了拿到 ProEvaluationServiceOssImpl 唯一实现 (PublicEvaluationController 注入).
            ★ 启动类 @ComponentScan 不再扫描 com.jc.rag.admin.*, 避免 admin 的 SecurityConfig 与 user 的 UserSecurityConfig 冲突.
            ★ ProEvaluationServiceOssImpl 通过启动类的 @Bean 方法显式注册.
        -->
        <dependency>
            <groupId>com.jc</groupId>
            <artifactId>jc-rag-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Flyway 数据库迁移
            user 端不直接放 SQL, 通过 jc-rag-admin 依赖自动加载 community/ 目录
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>config</directory>
                <includes>
                    <include>**/*.yml</include>
                    <include>**/*.yaml</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 商业版启动模块统一 repackage, 社区版不重复 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
