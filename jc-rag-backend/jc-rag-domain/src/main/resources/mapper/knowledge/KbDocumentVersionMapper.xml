<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.rag.domain.mapper.knowledge.KbDocumentVersionMapper">

    <resultMap id="BaseResultMap" type="com.jc.rag.domain.entity.knowledge.KbDocumentVersionEntity">
        <id column="id" property="id"/>
        <result column="document_id" property="documentId"/>
        <result column="version_no" property="versionNo"/>
        <result column="minio_object_name" property="minioObjectName"/>
        <result column="file_hash" property="fileHash"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <insert id="insertVersion" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kb_document_version
            (document_id, version_no, minio_object_name, file_hash, created_by, remark)
        VALUES
            (#{documentId}, #{versionNo}, #{minioObjectName}, #{fileHash}, #{createdBy}, #{remark})
    </insert>

    <select id="selectMaxVersionNo" resultType="int">
        SELECT COALESCE(MAX(version_no), 0) FROM kb_document_version WHERE document_id = #{documentId}
    </select>

</mapper>
