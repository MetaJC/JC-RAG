<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.rag.domain.mapper.rbac.RbacRoleMapper">

    <resultMap id="roleWithPermissions" type="java.util.LinkedHashMap">
        <result column="id" property="id" jdbcType="BIGINT"/>
        <result column="role_code" property="roleCode" jdbcType="VARCHAR"/>
        <result column="role_name" property="roleName" jdbcType="VARCHAR"/>
        <result column="role_desc" property="roleDesc" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="is_admin" property="isAdmin" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="permission_ids" property="permissionIds" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="countRoles" resultType="long">
        SELECT COUNT(DISTINCT r.id)
        FROM rbac_role r
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (r.role_name LIKE #{keyword} OR r.role_code LIKE #{keyword})
        </if>
    </select>

    <sql id="roleListColumns">
        SELECT r.id, r.role_code, r.role_name, r.role_desc, r.status, r.is_admin, r.created_at,
               GROUP_CONCAT(rp.permission_id ORDER BY rp.permission_id SEPARATOR ',') AS permission_ids
        FROM rbac_role r
        LEFT JOIN rbac_role_permission rp ON rp.role_id = r.id
        WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND (r.role_name LIKE #{keyword} OR r.role_code LIKE #{keyword})
        </if>
        GROUP BY r.id
        ORDER BY r.id DESC
    </sql>

    <select id="pageRoles" resultMap="roleWithPermissions">
        <include refid="roleListColumns"/>
    </select>

    <select id="listRoles" resultMap="roleWithPermissions">
        <include refid="roleListColumns"/>
    </select>

    <select id="selectIdByRoleCode" resultType="java.lang.Long">
        SELECT id
        FROM rbac_role
        WHERE role_code = #{roleCode}
        LIMIT 1
    </select>

    <!-- 校验: 用户是否拥有至少一个 is_admin=1 的角色 (登录管理端准入校验) -->
    <select id="countAdminRoleByUserId" resultType="long">
        SELECT COUNT(1)
        FROM rbac_user_role ur
        JOIN rbac_role r ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND r.is_admin = 1
          AND r.status = 1
    </select>

</mapper>
