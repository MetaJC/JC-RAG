<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.rag.domain.mapper.rbac.RbacUserRoleMapper">

    <select id="selectRoleIdsByUserId" resultType="java.lang.Long">
        SELECT role_id
        FROM rbac_user_role
        WHERE user_id = #{userId}
    </select>

    <select id="selectUserIdsByRoleId" resultType="java.lang.Long">
        SELECT user_id
        FROM rbac_user_role
        WHERE role_id = #{roleId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM rbac_user_role WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM rbac_user_role WHERE role_id = #{roleId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO rbac_user_role (user_id, role_id) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.roleId})
        </foreach>
    </insert>

</mapper>
