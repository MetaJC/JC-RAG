# JC RAG 开源版 Docker 环境变量示例
# 复制为同目录 .env 后按需修改（.env 已被 .gitignore 忽略，不入库）
# 详细说明见 docker-compose.yml

# ---------- MinIO（远程对象存储，供 Milvus 使用） ----------
# 远程 MinIO 地址（含端口）
MINIO_ADDRESS=localhost:9000
# 访问凭证（对应 docker-compose 中 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- MySQL ----------
# root 密码
MYSQL_ROOT_PASSWORD=change-me
# 初始数据库名
DB_NAME=jc_rag

# ---------- Ollama（可选，本地大模型） ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
