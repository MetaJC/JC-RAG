# ===== Vite environment for jc-rag-admin-web =====
# 所有 URL 默认值集中在此；运行时仍以后端 /api/system/runtime-config 为准，本文件仅作前端占位默认。

# 当前服务自身（vite dev server）
VITE_FRONTEND_PORT=5173

# 反向代理到 admin backend（必须与 server.port 一致）
VITE_ADMIN_BACKEND_URL=http://localhost:8080

# Python RAG 服务
VITE_PYTHON_RAG_URL=http://localhost:8001

# Ollama（默认模型运行时）
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_CHAT_PATH=/api/chat
VITE_OLLAMA_TAGS_PATH=/api/tags

# LM Studio
VITE_LMSTUDIO_URL=http://localhost:1234

# Elasticsearch
VITE_ELASTICSEARCH_URL=http://localhost:9200

# MinIO
VITE_MINIO_URL=http://localhost:9000

# 本地嵌入模型默认路径
VITE_DEFAULT_EMBEDDING_MODEL_PATH=D:\models\embedding\bge-large-zh-v1.5
